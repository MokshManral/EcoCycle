# Base URL of the FastAPI backend (no trailing slash needed)
VITE_API_URL=http://localhost:8000

# true  = run entirely on src/mock data, no backend required
# false = call the real backend
# NOTE: every VITE_ variable is public in the browser bundle. Never put secrets here.
VITE_USE_MOCK_DATA=true

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
