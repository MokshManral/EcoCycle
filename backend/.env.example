# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./EcoCycle.db
# PostgreSQL (production): DATABASE_URL=postgresql://user:pass@host:5432/EcoCycle

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173

# ── AI Classifier ─────────────────────────────────────────────────────────────
# true  → keyword mock, no AWS needed (default for local dev + CI)
# false → local image-based classifier first, with Bedrock fallback if configured
MOCK_CLASSIFIER=false

# ── AWS credentials ────────────────────────────────────────────────────────────
# Used by Strands Agents (Bedrock) when MOCK_CLASSIFIER=false.
#
# Option A — explicit keys (local dev):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Option B — IAM role (EC2 / ECS / Lambda):
#   Leave the keys blank; boto3 picks up the role automatically.
#
# Minimum IAM permissions needed:
#   bedrock:InvokeModel on the model ARN below

# ── Strands / Bedrock model ────────────────────────────────────────────────────
# Claude Opus 4.8 — multimodal (vision), fast, available in all regions.
# Docs: https://docs.aws.amazon.com/bedrock/latest/userguide/model-card-anthropic-claude-opus-4-8.html
#
# Options:
#   anthropic.claude-opus-4-8          ← in-region (recommended)
#   us.anthropic.claude-opus-4-8       ← US geo cross-region failover
#   anthropic.claude-opus-4-7          ← previous version
#
# ⚠  Opus 4.7+ does NOT support temperature / top_p / top_k — omit them entirely.
BEDROCK_MODEL_ID=anthropic.claude-opus-4-8

# ── Uploads ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=5242880
